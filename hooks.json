{
  "prevent-permanent-deletion": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python {{SCRIPTS_DIR}}\\check_delete_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
